{
  "contract": "07-api/contracts/openapi/auth-service.yaml",
  "note": "What the contract requires of each operation that csp-auth-portal calls. scripts/check-contract.mjs compares this table with the contract in CI; the spec src/app/auth/contract/auth-api.contract.spec.ts makes every call and checks it.",
  "operations": [
    { "operationId": "register", "method": "POST", "path": "/register", "requiredHeaders": ["Idempotency-Key"] },
    { "operationId": "login", "method": "POST", "path": "/login", "requiredHeaders": [] },
    { "operationId": "refreshToken", "method": "POST", "path": "/refresh", "requiredHeaders": [] },
    { "operationId": "logout", "method": "POST", "path": "/logout", "requiredHeaders": [] },
    { "operationId": "requestPasswordReset", "method": "POST", "path": "/forgot-password", "requiredHeaders": [] },
    { "operationId": "resetPassword", "method": "POST", "path": "/reset-password", "requiredHeaders": [] },
    { "operationId": "requestEmailChange", "method": "PATCH", "path": "/me/email", "requiredHeaders": ["Idempotency-Key"] },
    { "operationId": "verifyEmailChange", "method": "POST", "path": "/me/email/verify", "requiredHeaders": ["Idempotency-Key"] },
    { "operationId": "listUsers", "method": "GET", "path": "/users", "requiredHeaders": [] },
    { "operationId": "updateUserRole", "method": "PATCH", "path": "/users/{userId}/role", "requiredHeaders": ["Idempotency-Key"] },
    { "operationId": "getMyProfile", "method": "GET", "path": "/me", "requiredHeaders": [] },
    { "operationId": "updateMyProfile", "method": "PATCH", "path": "/me", "requiredHeaders": [] },
    { "operationId": "changeMyPassword", "method": "POST", "path": "/me/password", "requiredHeaders": [] }
  ]
}
